    "request_id": "reset-20261119_184550_851c5b18aa8c4fbdbe26e8bf7b9152f8",
    "scenario_id": "wanqing_apartment_morning",
    "title": "工作日上午 · 公寓 · 嫂子",
    "weekday": "周二"
  },
  "request_id": "live-8a1c5c47-bd6b-46e7-8190-4ae55ea536cd",
  "round": 1,
  "sceneTitle": "市中心顶层公寓",
  "state_version": 3,
  "storyNodes": [
    {
      "text": "你留在餐台旁，告诉嫂子今天就待在这里陪陪她。",
      "type": "narration"
    },
    {
      "text": "苏婉青正要去取餐巾，闻言回过头。她把餐巾放在桌边，朝你笑了笑。",
      "type": "narration"
    },
    {
      "speaker": "苏婉青",
      "text": "那就留下来呀。有人陪着吃早饭，我也高兴。",
      "type": "dialogue"
    },
    {
      "text": "她把已经盛好的煎蛋摆到你这侧，添好餐具，又给你拉开一把椅子。随后回到灶边，把用过的锅移稳，擦净手。",
      "type": "narration"
    },
    {
      "text": "你搭着台沿的指腹触到石面的凉意，椅脚擦过地砖的轻响就在身侧。她给你留的位置隔着餐桌，能面对面说话，也各有活动的余地。",
      "type": "narration"
    },
    {
      "speaker": "苏婉青",
      "text": "不过下午我还是照原来的安排去看婆婆。上午收拾屋子时，你跟我说说话就好，不用特意找事情做。",
      "type": "dialogue"
    },
    {
      "text": "她在桌子的另一侧坐下，把那只空杯移到你的餐位前，抬眼等你的意思。",
      "type": "narration"
    },
    {
      "speaker": "苏婉青",
      "text": "先坐吧。咖啡还是温水？等吃完，你也帮我想想，下午带哪两样水果合适。",
      "type": "dialogue"
    }
  ],
