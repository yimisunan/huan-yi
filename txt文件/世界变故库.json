  "offstage_clocks": {
    "CLK_XCY": {
      "owner": "徐承邺",
      "max_segments": 4,
      "soft_at": 3,
      "k01_guard": "严守信息差与真实证据：徐承邺未获实证前绝不凭空知晓未暴露秘密；若其不在当前场景，严禁瞬移现身或输出[D:徐承邺]。",
      "phases": [
        {
          "label": "深圳分部账目与家宅近况远程抽查",
          "channel_hint": "offstage_ripple",
          "soft_omen": "徐承邺虽在外地，但借回寄物件随附的问询、管家或助理转递的家宅杂务确认，隐约显出他正远程留意家里近期动向与账目细目。",
          "hard_landing": "徐承邺的远程核查落到实处：一项必须尽快给答复的家宅行程、开销或近况问询经合理现实渠道传到现场（不在场时仅由在场人转述或旁白呈递，严禁瞬移发言）。"
        },
        {
          "label": "外地行程波动与临时返城风声",
          "channel_hint": "third_party",
          "soft_omen": "通过保姆整理客房、秘书核对车库或外地项目进度风声，透出徐承邺近期可能提前压缩外地行程、抽空回城一趟的苗头。",
          "hard_landing": "徐承邺的行程变动传出明确节点：外地事务暂告一段落或临时改期，令家里与公寓两侧的时间窗明显收紧，相关人物各自暗自绷紧神经。"
        }
      ]
    },
    "CLK_SZY": {
