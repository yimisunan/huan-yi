  "facts": {
    "R01": {
      "type": "mother_son",
      "subject": "沈知韫",
      "object": "徐志北",
      "known_by": "*",
      "text": "沈知韫为徐志北生母；徐志北是亲生子，不能写成养子。"
    },
    "R02": {
      "type": "father_son",
      "subject": "徐家亡父",
      "object": "徐志北",
      "known_by": "*",
      "text": "徐家亡父是徐志北生父，已故，为徐家创始人与遗嘱立者。"
    },
    "R03": {
      "type": "marriage",
      "subject": "徐家亡父",
      "object": "沈知韫",
      "known_by": "*",
      "text": "沈知韫为徐家亡父之妻；亡夫已故。"
    },
    "R04": {
      "type": "adoptive_mother_son",
      "subject": "沈知韫",
      "object": "徐承邺",
      "known_by": "*",
      "text": "沈知韫为徐承邺养母，徐承邺为徐家养子。"
    },
    "R05": {
      "type": "adoptive_mother_daughter",
      "subject": "沈知韫",
      "object": "徐念薇",
      "known_by": "*",
      "text": "沈知韫为徐念薇养母，徐念薇为徐家养女。"
    },
    "R06": {
      "type": "marriage",
      "subject": "徐承邺",
      "object": "苏婉青",
      "known_by": "*",
      "text": "徐承邺与苏婉青是夫妻；苏婉青在徐家为少奶奶。"
    },
    "R07": {
      "type": "in_law_mother",
      "subject": "沈知韫",
      "object": "苏婉青",
      "known_by": "*",
      "text": "沈知韫是苏婉青的婆婆，苏婉青为其儿媳。"
    },
    "R08": {
      "type": "brothers",
      "subject": "徐承邺",
      "object": "徐志北",
      "known_by": "*",
      "text": "徐承邺是徐志北的养兄、长兄；徐志北为其养弟。"
    },
    "R09": {
      "type": "brother_sister",
      "subject": "徐承邺",
      "object": "徐念薇",
      "known_by": "*",
      "text": "徐承邺是徐念薇的养兄；徐念薇为其养妹、家中二姐。"
    },
    "R10": {
      "type": "sister_brother",
      "subject": "徐念薇",
      "object": "徐志北",
      "known_by": "*",
      "text": "徐念薇是徐志北的养姐、二姐；徐志北为其养弟。"
    },
    "R11": {
      "type": "in_law_brother",
      "subject": "苏婉青",
      "object": "徐志北",
      "known_by": "*",
      "text": "苏婉青是徐志北的嫂子；徐志北为其小叔。"
    },
    "R12": {
      "type": "in_law_sister",
      "subject": "苏婉青",
      "object": "徐念薇",
      "known_by": "*",
      "text": "苏婉青是徐念薇的嫂子；徐念薇为其小姑。"
    },
    "K01": {
      "type": "heir",
      "subject": "徐家亡父",
      "object": "徐志北",
      "known_by": [
        "沈知韫"
      ],
      "text": "亡夫遗嘱指定徐志北为千亿家产唯一合法继承人，而非徐承邺。"
    }
  },
