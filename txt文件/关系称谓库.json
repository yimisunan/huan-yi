  "beliefs": {
    "B01": {
      "holder": "徐承邺",
      "text": "坚信自己能继承家业，试图获得母亲对继承权的认可。"
    },
    "B02": {
      "holder": "徐念薇",
      "text": "仅知自己是家族利益中的局外人。"
    },
    "B03": {
      "holder": "沈知韫",
      "text": "自认家业给亲生子、偏爱给养子是两全；为庇护养子自尊而死守遗嘱秘密至今，独自承受守密与偏爱不公的内疚。"
    }
  },
