  "rollback_command": "python3 -c 'from pathlib import Path\nimport hashlib,json,os,uuid\nroot=Path.cwd().resolve()\nmanifest=json.loads((root/\"开发者功能/修订日志/2026.11/回合执行基础/src/安装清单_8.json\").read_text(encoding=\"utf-8\"))\nrows=manifest[\"changes\"]\nfor row in rows:\n    p=root/row[\"path\"]\n    b=root/row[\"backup\"]\n    assert p.resolve().is_relative_to(root) and b.resolve().is_relative_to(root)\n    assert hashlib.sha256(b.read_bytes()).hexdigest()==row[\"before\"][\"sha256\"]\n    assert hashlib.sha256(p.read_bytes()).hexdigest() in {row[\"before\"][\"sha256\"],row[\"after\"][\"sha256\"]}, row[\"path\"]+\" changed after this task\"\nfor row in rows:\n    p=root/row[\"path\"]\n    temporary=p.with_name(p.name+\".round-tmp-\"+uuid.uuid4().hex)\n    try:\n        with temporary.open(\"xb\") as f:\n            f.write((root/row[\"backup\"]).read_bytes());f.flush();os.fsync(f.fileno())\n        os.replace(temporary,p)\n    finally:\n        if temporary.exists():temporary.unlink()\n    assert hashlib.sha256(p.read_bytes()).hexdigest()==row[\"before\"][\"sha256\"]\nprint(\"RESTORED\",len(rows))\n'",
